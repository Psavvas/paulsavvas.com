---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutContentHtml } from '../lib/about-content';

const pageTitle = 'About | Paul Savvas';
const pageDesc =
  'About Paul Savvas, student engineer building practical tools across software, hardware, and 3D design.';

// Every section below is editable at /admin/about; a field left empty there
// falls back to the built-in copy in src/lib/about-content.ts.
const content = await getAboutContentHtml();

const proseCls = 'prose prose-neutral dark:prose-invert max-w-none';
// The cards keep the original flush-left, marker-free list styling, so the
// editable Markdown renders exactly like the copy it replaced.
const cardProseCls = `${proseCls} prose-sm prose-ul:my-0 prose-ul:list-none prose-ul:pl-0 prose-li:my-0 prose-li:pl-0 [&_li+li]:mt-3 prose-strong:font-medium`;
const cardCls =
  'rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-950 hover-lift animate-fade-in-up';
const cardHeadingCls =
  'text-lg font-semibold text-neutral-900 dark:text-neutral-100';
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div
    class="min-h-screen bg-white font-sans dark:bg-neutral-950 transition-colors"
  >
    <main
      class="mx-auto w-full max-w-6xl bg-white px-6 py-16 dark:bg-neutral-950 sm:px-16 sm:py-24 animate-fade-in"
    >
      <header class="w-full animate-fade-in-up">
        <p
          class="text-sm font-medium uppercase tracking-wider text-neutral-600 dark:text-neutral-400"
        >
          {content.eyebrow}
        </p>
        <h1
          class="mt-3 text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-5xl"
        >
          {content.heading}
        </h1>
        <div class={`mt-6 ${proseCls}`} set:html={content.introHtml} />
      </header>

      <!-- Two-column cards -->
      <section class="mt-14 grid gap-10 md:grid-cols-2">
        <div class={cardCls}>
          <h2 class={cardHeadingCls}>{content.valuesHeading}</h2>
          <div class={`mt-4 ${cardProseCls}`} set:html={content.valuesHtml} />
        </div>

        <div class={cardCls}>
          <h2 class={cardHeadingCls}>{content.workHeading}</h2>
          <div class={`mt-4 ${cardProseCls}`} set:html={content.workHtml} />
        </div>
      </section>

      <!-- Now section -->
      <section class="mt-14 w-full animate-fade-in-up animation-delay-300">
        <h2
          class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
        >
          {content.nowHeading}
        </h2>
        <div class={`mt-4 ${proseCls}`} set:html={content.nowHtml} />
        {
          content.linksHtml && (
            <div
              class="mt-8 flex flex-wrap gap-4"
              set:html={content.linksHtml}
            />
          )
        }
      </section>
    </main>
  </div>
</BaseLayout>
