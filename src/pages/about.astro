---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAboutContentHtml } from '../lib/about-content';

const content = await getAboutContentHtml();
const sections = [
  { heading: content.valuesHeading, html: content.valuesHtml },
  { heading: content.workHeading, html: content.workHtml },
  {
    heading: content.nowHeading,
    html: content.nowHtml,
    links: content.linksHtml,
  },
];
---

<BaseLayout
  title="About | Paul Savvas"
  description="About Paul Savvas, student engineer building practical tools across software, hardware, and 3D design."
>
  <main class="site-frame page-shell about-page">
    <PageHeader label={content.eyebrow} heading={content.heading} />
    <div class="about-intro prose reading-prose" set:html={content.introHtml} />

    <div class="glass-panel about-sections">
      {
        sections.map(({ heading, html, links }) => (
          <section class="about-section">
            <h2 class="section-heading">{heading}</h2>
            <div>
              <div class="prose reading-prose" set:html={html} />
              {links && <div class="action-row" set:html={links} />}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>
