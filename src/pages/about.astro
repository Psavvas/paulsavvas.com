---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAboutContentHtml } from '../lib/about-content';

const pageTitle = 'About | Paul Savvas';
const pageDesc =
  'About Paul Savvas, student engineer building practical tools across software, hardware, and 3D design.';

const content = await getAboutContentHtml();
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <main class="site-frame page-shell">
    <PageHeader label={content.eyebrow} heading={content.heading} />
    <div class="prose reading-prose about-intro" set:html={content.introHtml} />

    <div class="about-grid">
      <section class="about-panel">
        <h2 class="section-heading">{content.valuesHeading}</h2>
        <div class="prose reading-prose" set:html={content.valuesHtml} />
      </section>
      <section class="about-panel">
        <h2 class="section-heading">{content.workHeading}</h2>
        <div class="prose reading-prose" set:html={content.workHtml} />
      </section>
    </div>

    <section class="split-section">
      <h2 class="section-heading">{content.nowHeading}</h2>
      <div>
        <div class="prose reading-prose" set:html={content.nowHtml} />
        {
          content.linksHtml && (
            <div class="action-row" set:html={content.linksHtml} />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
