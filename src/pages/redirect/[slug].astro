---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UiIcon from '../../components/UiIcon.astro';
import { getRedirectDestination } from '../../lib/redirects';

const { slug } = Astro.params;
const destination = slug ? await getRedirectDestination(slug) : undefined;

if (!destination) {
  return Astro.redirect('/404');
}

const linkType = destination.startsWith('/')
  ? 'internal page'
  : 'external site';
---

<BaseLayout title="Redirecting... | Paul Savvas">
  <main class="site-frame page-shell message-page">
    <p class="section-label">Redirecting</p>
    <h1 class="display-heading">Taking you to your destination...</h1>
    <p class="message-copy">
      You're being redirected to an {linkType}. If you're not redirected
      automatically, click the button below.
    </p>
    <a href={destination} class="site-btn site-btn--primary">
      Continue to destination <UiIcon name="arrow" />
    </a>
    <p class="redirect-destination">Destination: <code>{destination}</code></p>
  </main>

  <script is:inline data-destination={destination}>
    const redirectTo = document.currentScript?.dataset.destination;
    if (redirectTo) {
      window.setTimeout(() => window.location.replace(redirectTo), 1500);
    }
  </script>
</BaseLayout>
