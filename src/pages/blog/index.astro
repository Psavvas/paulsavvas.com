---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SearchBar from '../../components/SearchBar.astro';
import UiIcon from '../../components/UiIcon.astro';
import { getPublishedBlogPosts } from '../../lib/blog';

const posts = await getPublishedBlogPosts();
---

<BaseLayout
  title="Blog | Paul Savvas"
  description="Blog posts by Paul Savvas — project notes, lessons learned, and build write-ups."
>
  <main class="site-frame page-shell journal-page">
    <div class="journal-intro">
      <PageHeader label="Blog" heading="Notes and write-ups">
        <p>
          Short posts about projects, engineering decisions, and what I learn
          while building.
        </p>
      </PageHeader>
      {
        posts.length > 0 && (
          <div class="archive-controls">
            <SearchBar
              targetId="blog-list"
              emptyId="blog-empty"
              countId="blog-count"
              label="Search blog posts"
              placeholder="Search posts"
            />
            <p id="blog-count" class="result-count" aria-live="polite" />
          </div>
        )
      }
    </div>

    <section class="journal-feed" aria-label="Blog posts">
      {
        posts.length === 0 ? (
          <div class="glass-panel empty-state">
            <h2>Coming soon</h2>
            <p>I'm working on the first set of posts now.</p>
          </div>
        ) : (
          <>
            <div id="blog-list" class="journal-list">
              {posts.map(({ title, slug, date, dateIso, summary, tags }) => (
                <article
                  class="glass-panel journal-card"
                  data-search={[title, summary, ...tags]
                    .join(' ')
                    .toLowerCase()}
                >
                  {date && (
                    <time class="section-label" datetime={dateIso}>
                      {date}
                    </time>
                  )}
                  <h2>{title}</h2>
                  <p>{summary}</p>
                  {tags.length > 0 && (
                    <ul class="tag-row" aria-label="Tags">
                      {tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                  )}
                  <a
                    class="card-action"
                    href={`/blog/${slug}`}
                    aria-label={`Read ${title}`}
                  >
                    Read post <UiIcon name="arrow" />
                  </a>
                </article>
              ))}
            </div>
            <div id="blog-empty" class="glass-panel empty-state hidden">
              <h2>No posts found</h2>
              <p>No posts match your search. Try a different keyword.</p>
            </div>
          </>
        )
      }
    </section>
  </main>
</BaseLayout>
