---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getBlogPostBySlug } from '../../lib/blog';
import { getPublishedProjects } from '../../lib/projects';

const slug = Astro.params.slug;
const post = slug ? await getBlogPostBySlug(slug) : undefined;

if (!post) {
  return Astro.redirect('/404');
}

const featuredProject = post.featuredProjectSlug
  ? (await getPublishedProjects()).find(
      (project) => project.slug === post.featuredProjectSlug
    )
  : undefined;
---

<EntryLayout
  title={post.title}
  summary={post.summary}
  section="Blog"
  date={post.date}
  tags={post.tags}
  bodyHtml={post.bodyHtml}
  related={featuredProject && {
    label: 'Featured Project',
    title: featuredProject.title,
    href: `/projects/${featuredProject.slug}`,
  }}
/>
