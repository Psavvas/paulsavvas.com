---
import EntryLayout from '../../layouts/EntryLayout.astro';
import AiDisclosure from '../../components/AiDisclosure.astro';
import { formatProjectYear, getProjectBySlug } from '../../lib/projects';
import { getPublishedBlogPosts } from '../../lib/blog';

const slug = Astro.params.slug;
const entry = slug ? await getProjectBySlug(slug) : undefined;

if (!entry) {
  return Astro.redirect('/404');
}

const featuredPost = entry.featuredBlog
  ? (await getPublishedBlogPosts()).find(
      (post) => post.slug === entry.featuredBlog
    )
  : undefined;
---

<EntryLayout
  title={entry.title}
  summary={entry.summary}
  section="Projects"
  date={formatProjectYear(entry.year)}
  tags={entry.tags}
  bodyHtml={entry.bodyHtml}
  related={featuredPost && {
    label: 'Featured Blog Post',
    title: featuredPost.title,
    href: `/blog/${featuredPost.slug}`,
  }}
>
  {
    entry.aiBuilt && (
      <div class="entry-disclosure">
        <AiDisclosure />
      </div>
    )
  }
  {entry.topLinksHtml && <div set:html={entry.topLinksHtml} />}
</EntryLayout>
