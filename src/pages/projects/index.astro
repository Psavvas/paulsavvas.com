---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import SearchBar from '../../components/SearchBar.astro';
import UiIcon from '../../components/UiIcon.astro';
import {
  formatProjectYear,
  getProjectDestination,
  getPublishedProjects,
} from '../../lib/projects';

const projects = (await getPublishedProjects()).map((project) => {
  const year = formatProjectYear(project.year);

  return {
    title: project.title,
    summary: project.summary,
    tags: project.tags,
    year,
    featured: project.featured,
    destination: getProjectDestination(project),
    searchText: [
      project.title,
      project.summary,
      year,
      ...project.tags,
      project.aiBuilt ? 'built with ai vibe coded' : undefined,
    ]
      .filter(Boolean)
      .join(' ')
      .toLowerCase(),
  };
});
const featured = projects.filter((project) => project.featured);
---

<BaseLayout
  title="Projects | Paul Savvas"
  description="Projects by Paul Savvas — a selection of work across software, hardware, and 3D design."
>
  <main class="site-frame page-shell projects-page">
    <PageHeader label="Projects" heading="Simple. Practical. Impactful.">
      <p>
        A growing collection of software, hardware, and 3D design work. I'm
        drawn to projects that can have a positive impact on the world—whether
        in small, everyday ways or larger initiatives—while staying grounded in
        real constraints and performing well in practice.
      </p>
    </PageHeader>

    {
      featured.length > 0 && (
        <section class="page-section" aria-labelledby="featured-title">
          <div class="section-intro">
            <h2 id="featured-title" class="section-heading">
              Featured Projects
            </h2>
            <p>A few of my most impactful, noteworthy or favorite projects.</p>
          </div>
          <ul class="project-gallery">
            {featured.map((project) => (
              <li>
                <ProjectTile {...project} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="page-section" aria-labelledby="all-projects-title">
      <div class="collection-header">
        <div class="section-intro">
          <h2 id="all-projects-title" class="section-heading">All projects</h2>
          <p>A complete list of projects with links and quick context.</p>
        </div>
        <div class="archive-controls">
          <SearchBar
            targetId="project-list"
            emptyId="project-empty"
            countId="project-count"
            label="Search projects"
            placeholder="Search by name, summary, tag, or year"
          />
          <p id="project-count" class="result-count" aria-live="polite"></p>
        </div>
      </div>

      <ul id="project-list" class="project-collection">
        {
          projects.map((project) => (
            <li data-search={project.searchText}>
              <ProjectTile {...project} featured={false} />
            </li>
          ))
        }
      </ul>
      <div
        id="project-empty"
        class:list={[
          'glass-panel empty-state',
          { hidden: projects.length > 0 },
        ]}
      >
        <h3>No projects found</h3>
        <p>No projects match your search. Try a different keyword.</p>
      </div>
      <div class="action-row collection-links">
        <a
          class="site-btn"
          href="https://github.com/psavvas"
          target="_blank"
          rel="noopener noreferrer"
          >Browse all code projects on GitHub <UiIcon name="external" /></a
        >
        <a
          class="site-btn"
          href="https://www.thingiverse.com/psavvas"
          target="_blank"
          rel="noopener noreferrer"
          >Browse all 3D design projects on Thingiverse <UiIcon
            name="external"
          /></a
        >
      </div>
    </section>

    <section class="glass-panel criteria-panel">
      <h2 class="section-heading">How I evaluate a project</h2>
      <ul class="criteria-list">
        <li>
          <strong>Clarity:</strong> can someone understand the goal and approach quickly?
        </li>
        <li>
          <strong>Constraints:</strong> does it work within real limits (time, materials,
          performance)?
        </li>
        <li>
          <strong>Results:</strong> are outcomes measurable, testable, and repeatable?
        </li>
        <li>
          <strong>Iteration:</strong> what changed after the first version shipped?
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>
