---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

export const prerender = false;

const pageTitle = 'Contact | Paul Savvas';
const pageDesc =
  'Contact Paul Savvas — reach out about projects, collaboration, or questions.';

const emailAddr = 'hello@paulsavvas.com';
const formUrl = 'https://psavvas.notion.site/15770b9af471809da736d4e77a090ce0';

const socialCards = [
  {
    heading: 'LinkedIn',
    blurb: 'Connect with me on LinkedIn.',
    cta: 'View LinkedIn',
    href: 'https://linkedin.com/in/pauldsavvas',
  },
  {
    heading: 'Gravatar',
    blurb: 'View my Gravatar profile, and other social profiles.',
    cta: 'View Gravatar',
    href: 'https://gravatar.com/paulsavvas',
  },
  {
    heading: 'GitHub',
    blurb: 'Get access to my open source coding projects.',
    cta: 'View GitHub',
    href: 'https://github.com/psavvas',
  },
  {
    heading: 'Thingiverse',
    blurb: 'Explore my 3D designs and projects.',
    cta: 'View Thingiverse',
    href: 'https://thingiverse.com/psavvas',
  },
];
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <main class="site-frame page-shell">
    <PageHeader label="Contact" heading="Let's connect.">
      <p>
        If you have a question, want to collaborate, or want to talk through a
        project idea, the links below are the best way to reach me.
      </p>
    </PageHeader>

    <section class="contact-grid" aria-label="Ways to get in touch">
      <div class="contact-panel">
        <span class="contact-icon"><UiIcon name="file" /></span>
        <h2 class="section-heading">Contact Form</h2>
        <p>
          Message me using the form below. I try to respond as soon as possible.
        </p>
        <a class="site-btn site-btn--primary" href={formUrl}
          >Open form <UiIcon name="external" /></a
        >
        <span class="contact-address">paulsavvas.com/redirect/contact</span>
      </div>
      <div class="contact-panel">
        <span class="contact-icon"><UiIcon name="mail" /></span>
        <h2 class="section-heading">Email</h2>
        <p>
          Contact me via email, and I'll make sure to try to respond within 3
          business days.
        </p>
        <a class="site-btn" href={`mailto:${emailAddr}`}
          >Send email <UiIcon name="arrow" /></a
        >
        <span class="contact-address">{emailAddr}</span>
      </div>
    </section>

    <section class="profile-grid" aria-label="Social profiles">
      {
        socialCards.map(({ heading, blurb, cta, href }) => (
          <article class="profile-item">
            <h2>{heading}</h2>
            <p>{blurb}</p>
            <a
              class="text-link"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {cta} <UiIcon name="external" />
            </a>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
