---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

export const prerender = false;

const emailAddr = 'hello@paulsavvas.com';
const formUrl = 'https://psavvas.notion.site/15770b9af471809da736d4e77a090ce0';

const profiles = [
  {
    heading: 'LinkedIn',
    blurb: 'Connect with me on LinkedIn.',
    cta: 'View LinkedIn',
    href: 'https://linkedin.com/in/pauldsavvas',
  },
  {
    heading: 'Gravatar',
    blurb: 'View my Gravatar profile, and other social profiles.',
    cta: 'View Gravatar',
    href: 'https://gravatar.com/paulsavvas',
  },
  {
    heading: 'GitHub',
    blurb: 'Get access to my open source coding projects.',
    cta: 'View GitHub',
    href: 'https://github.com/psavvas',
  },
  {
    heading: 'Thingiverse',
    blurb: 'Explore my 3D designs and projects.',
    cta: 'View Thingiverse',
    href: 'https://thingiverse.com/psavvas',
  },
];
---

<BaseLayout
  title="Contact | Paul Savvas"
  description="Contact Paul Savvas — reach out about projects, collaboration, or questions."
>
  <main class="site-frame page-shell">
    <PageHeader label="Contact" heading="Let's connect.">
      <p>
        If you have a question, want to collaborate, or want to talk through a
        project idea, the links below are the best way to reach me.
      </p>
    </PageHeader>

    <section
      class="glass-panel contact-methods"
      aria-label="Ways to get in touch"
    >
      <article class="contact-method">
        <span class="tile-icon"><UiIcon name="file" /></span>
        <div>
          <h2 class="section-heading">Contact Form</h2>
          <p>
            Message me using the form below. I try to respond as soon as
            possible.
          </p>
          <p class="contact-address">paulsavvas.com/redirect/contact</p>
        </div>
        <a class="site-btn site-btn--primary" href={formUrl}
          >Open form <UiIcon name="external" /></a
        >
      </article>
      <article class="contact-method">
        <span class="tile-icon"><UiIcon name="mail" /></span>
        <div>
          <h2 class="section-heading">Email</h2>
          <p>
            Contact me via email, and I'll make sure to try to respond within 3
            business days.
          </p>
          <p class="contact-address">{emailAddr}</p>
        </div>
        <a class="site-btn" href={`mailto:${emailAddr}`}
          >Send email <UiIcon name="arrow" /></a
        >
      </article>
    </section>

    <section class="profile-shelf" aria-label="Social profiles">
      {
        profiles.map(({ heading, blurb, cta, href }) => (
          <a
            class="glass-panel profile-link"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={cta}
            aria-describedby={`profile-${heading}`}
          >
            <h2>{heading}</h2>
            <span class="tile-arrow">
              <UiIcon name="external" />
            </span>
            <p id={`profile-${heading}`}>{blurb}</p>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>
