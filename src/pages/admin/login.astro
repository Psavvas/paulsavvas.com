---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAuth, getAuthConfigError, isAuthConfigured } from '../../lib/auth';
import {
  checkLoginThrottle,
  clearLoginAttempts,
  recordFailedLogin,
} from '../../lib/login-throttle';

const configured = isAuthConfigured();
const configError = getAuthConfigError();

/**
 * The Vercel adapter populates `clientAddress` from the platform's own headers.
 * It throws on adapters that can't supply one, which only bounds the per-IP
 * limit — the per-email limit still applies.
 */
function clientIp(): string | null {
  try {
    return Astro.clientAddress || null;
  } catch {
    return null;
  }
}

const GENERIC_ERROR = 'Incorrect email or password. Please try again.';

let error = '';
let email = '';

if (Astro.request.method === 'POST' && configured) {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');
  const ip = clientIp();

  const requested = Astro.url.searchParams.get('next') ?? '/admin';
  const next =
    requested.startsWith('/admin') && !requested.startsWith('//')
      ? requested
      : '/admin';

  try {
    // Throttle before touching the password check, so a locked-out attacker
    // learns nothing from how long the response takes.
    const throttle = await checkLoginThrottle(email, ip);

    if (throttle.blocked) {
      error = `Too many failed attempts. Try again in ${throttle.retryAfterMinutes} minute${
        throttle.retryAfterMinutes === 1 ? '' : 's'
      }.`;
    } else {
      // Sign in server-side, then forward Better Auth's session cookies onto
      // our own redirect so the whole flow works without client-side JS.
      const result = await getAuth().api.signInEmail({
        body: { email, password },
        headers: Astro.request.headers,
        asResponse: true,
      });

      if (result.ok) {
        await clearLoginAttempts(email, ip);

        const redirect = new Response(null, {
          status: 302,
          headers: { Location: next },
        });
        for (const cookie of result.headers.getSetCookie()) {
          redirect.headers.append('set-cookie', cookie);
        }
        return redirect;
      }

      await recordFailedLogin(email, ip);
      error = GENERIC_ERROR;
    }
  } catch (cause) {
    // Better Auth throws an APIError on bad credentials, which is the common
    // case; anything else (an unreachable database, a failed throttle write)
    // must not fall through to an unthrottled retry, so it also fails closed.
    try {
      await recordFailedLogin(email, ip);
      error = GENERIC_ERROR;
    } catch {
      console.error('Login is unavailable — the attempt store failed.', cause);
      error = 'Login is temporarily unavailable. Please try again shortly.';
    }
  }
}

const inputCls =
  'mt-1 w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none focus:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:focus:border-neutral-500';
const labelCls =
  'block text-sm font-medium text-neutral-900 dark:text-neutral-100';
---

<AdminLayout title="Log in" bare>
  <div class="mx-auto w-full max-w-sm">
    <div class="login-card">
      <span class="brand-mark" aria-hidden="true"></span>
      <p
        class="text-sm font-medium uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
      >
        Site Admin
      </p>
      <h1
        class="mt-2 text-2xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        Log in
      </h1>
      <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">
        Sign in to manage projects, blog posts, redirects, and site content.
      </p>

      {
        !configured && (
          <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
            <p class="font-medium">Authentication is not configured yet.</p>
            <p class="mt-1">{configError}</p>
            <p class="mt-2">
              Add it in your hosting dashboard (Vercel →{' '}
              <em>Settings → Environment Variables</em>) and redeploy.
            </p>
          </div>
        )
      }

      {
        error && (
          <div class="mt-4 rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
            {error}
          </div>
        )
      }

      <form method="post" class="mt-6 space-y-4">
        <div>
          <label for="email" class={labelCls}>Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="username"
            value={email}
            disabled={!configured}
            class={inputCls}
          />
        </div>

        <div>
          <label for="password" class={labelCls}>Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            disabled={!configured}
            class={inputCls}
          />
        </div>

        <button
          type="submit"
          disabled={!configured}
          class="site-btn site-btn--primary w-full"
        >
          Log in
        </button>
      </form>
    </div>

    <p class="mt-6 text-center text-xs text-neutral-500 dark:text-neutral-400">
      <a href="/" class="hover:underline">← Back to paulsavvas.com</a>
    </p>
  </div>
</AdminLayout>
