---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
import {
  getLatestProject,
  getProjectDestination,
  getPublishedProjects,
} from '../lib/projects';
import { getPublishedBlogPosts } from '../lib/blog';

const [projects, posts] = await Promise.all([
  getPublishedProjects(),
  getPublishedBlogPosts(),
]);
const latestProject = getLatestProject(projects);
const latestPost = posts[0];
const destination = latestProject && getProjectDestination(latestProject);
const profiles = [
  { label: 'GitHub', href: 'https://github.com/psavvas' },
  { label: 'Thingiverse', href: 'https://www.thingiverse.com/psavvas' },
  { label: 'Gravatar', href: 'https://gravatar.com/paulsavvas' },
];
---

<BaseLayout
  title="Paul Savvas"
  description="Paul Savvas, student engineer who builds practical tools across software, hardware, and 3D design."
>
  <main class="site-frame home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-title">
        <p class="section-label">Student, Engineer, Developer and Leader</p>
        <h1 id="home-title">Paul Savvas</h1>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <img
          src="/wind-tunnel.webp"
          alt=""
          width="1024"
          height="1024"
          fetchpriority="high"
        />
        <div class="viewfinder">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>

      <div class="home-intro">
        <p>
          Hello, I am a STEM Academy student who builds practical tools to help
          the world work better. I combine engineering, design, and systems
          thinking to create solutions that are clear, durable, and genuinely
          useful. My work spans software, hardware, and 3D design, where I test
          ideas in real conditions and refine them until they hold up beyond the
          classroom. I value simplicity, structure, and impact, and aim to ship
          tools that solve real problems and improve over time.
        </p>
        <p>
          This website showcases my projects, designs, and contributions across
          various domains. Feel free to explore my work, and connect with me on
          GitHub, Thingiverse, or Gravatar.
        </p>
        <div class="action-row">
          <a class="site-btn site-btn--primary" href="/projects"
            >Explore projects <UiIcon name="arrow" /></a
          >
          <a class="site-btn" href="/about">About me <UiIcon name="arrow" /></a>
        </div>
        <ul class="home-profiles" aria-label="External profiles">
          {
            profiles.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label} <UiIcon name="external" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="activity-panel" aria-label="Latest activity and profile">
      <div class="activity-header">
        <p class="section-label">Status</p>
        <a
          class="status-link"
          data-status="UP"
          href="https://paulsavvas.instatus.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Site status: Live"
        >
          <span class="status-dot"></span>
          <span data-status-label>Live</span>
          <UiIcon name="external" />
        </a>
      </div>

      <dl class="activity-grid">
        <div>
          <dt>Latest project</dt>
          <dd>
            {
              latestProject && destination ? (
                <a
                  class="text-link"
                  href={destination.url}
                  {...(destination.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {latestProject.title}{' '}
                  <UiIcon name={destination.external ? 'external' : 'arrow'} />
                </a>
              ) : (
                (latestProject?.title ?? 'New project coming soon')
              )
            }
          </dd>
        </div>
        <div>
          <dt>Latest blog post</dt>
          <dd>
            {
              latestPost ? (
                <a class="text-link" href={`/blog/${latestPost.slug}`}>
                  {latestPost.title} <UiIcon name="arrow" />
                </a>
              ) : (
                'New post coming soon'
              )
            }
          </dd>
        </div>
        <div>
          <dt>Projects</dt>
          <dd>
            <a class="text-link" href="/projects"
              >{projects.length}
              {projects.length === 1 ? 'project' : 'projects'}
              <UiIcon name="arrow" /></a
            >
          </dd>
        </div>
        <div>
          <dt>Blog posts</dt>
          <dd>
            <a class="text-link" href="/blog"
              >{posts.length}
              {posts.length === 1 ? 'post' : 'posts'}
              <UiIcon name="arrow" /></a
            >
          </dd>
        </div>
      </dl>

      <dl class="profile-strip">
        <div><dt>School</dt><dd>GMHS STEM Academy</dd></div>
        <div><dt>Location</dt><dd>Maryland, USA</dd></div>
        <div class="profile-tags">
          <dt class="sr-only">Profile</dt><dd>
            STEM Academy · Grade 11 <span aria-hidden="true">/</span> Product + Engineering
          </dd>
        </div>
      </dl>
    </section>
  </main>
</BaseLayout>

<script>
  const labels = {
    UP: 'Live',
    HASISSUES: 'Issues',
    UNDERMAINTENANCE: 'Maintenance',
    DOWN: 'Outage',
    UNKNOWN: 'Unknown',
  } as const;

  const statusLink = document.querySelector<HTMLElement>('[data-status]');
  const statusLabel = statusLink?.querySelector('[data-status-label]');

  function updateStatus(value: unknown) {
    if (!statusLink || !statusLabel) return;
    const status = typeof value === 'string' ? value.toUpperCase() : '';
    const key = Object.hasOwn(labels, status)
      ? (status as keyof typeof labels)
      : 'UNKNOWN';

    statusLink.dataset.status = key;
    statusLabel.textContent = labels[key];
    statusLink.setAttribute('aria-label', 'Site status: ' + labels[key]);
  }

  if (statusLink) {
    fetch('https://paulsavvas.instatus.com/summary.json', { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error('Status request failed');
        return response.json();
      })
      .then((data) => updateStatus(data?.page?.status))
      .catch(() => updateStatus(undefined));
  }
</script>
