---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMedia from '../components/HeroMedia.astro';
import UiIcon from '../components/UiIcon.astro';
import {
  getLatestProject,
  getProjectDestination,
  getPublishedProjects,
} from '../lib/projects';
import { getPublishedBlogPosts } from '../lib/blog';

const [projects, posts] = await Promise.all([
  getPublishedProjects(),
  getPublishedBlogPosts(),
]);
const latestProject = getLatestProject(projects);
const latestPost = posts[0];
const projectLink = latestProject && getProjectDestination(latestProject);
const profiles = [
  { label: 'GitHub', href: 'https://github.com/psavvas' },
  { label: 'Thingiverse', href: 'https://www.thingiverse.com/psavvas' },
  { label: 'Gravatar', href: 'https://gravatar.com/paulsavvas' },
];

const recent = [
  {
    label: 'Latest project',
    icon: 'projects',
    title: latestProject?.title ?? 'New project coming soon',
    summary: latestProject?.summary,
    href: projectLink?.url,
    external: projectLink?.external,
  },
  {
    label: 'Latest blog post',
    icon: 'blog',
    title: latestPost?.title ?? 'New post coming soon',
    summary: latestPost?.summary,
    href: latestPost ? `/blog/${latestPost.slug}` : undefined,
    external: false,
  },
] as const;
---

<BaseLayout
  title="Paul Savvas"
  description="Paul Savvas, student engineer who builds practical tools across software, hardware, and 3D design."
>
  <a
    slot="toolbar"
    class="status-link"
    data-status="UNKNOWN"
    href="https://paulsavvas.instatus.com"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Site status: Unknown"
  >
    <span class="status-dot" aria-hidden="true"></span>
    <span data-status-label>Unknown</span>
    <UiIcon name="external" />
  </a>

  <main class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero-copy">
        <h1 id="home-title">Paul Savvas</h1>
        <p>Student, Engineer, Developer and Leader</p>
        <div class="action-row hero-actions">
          <a class="site-btn hero-primary" href="/projects"
            >Explore projects <UiIcon name="arrow" /></a
          >
          <a class="site-btn hero-secondary" href="/about">About me</a>
        </div>
      </div>
      <HeroMedia />
    </section>

    <div class="site-frame home-details">
      <section class="glass-panel home-bio" aria-labelledby="home-bio-title">
        <h2 id="home-bio-title" class="section-heading">About me</h2>
        <p class="profile-roles">
          STEM Academy · Grade 11 <span aria-hidden="true">/</span> Product + Engineering
        </p>
        <div class="bio-copy">
          <p>
            Hello, I am a STEM Academy student who builds practical tools to
            help the world work better. I combine engineering, design, and
            systems thinking to create solutions that are clear, durable, and
            genuinely useful. My work spans software, hardware, and 3D design,
            where I test ideas in real conditions and refine them until they
            hold up beyond the classroom. I value simplicity, structure, and
            impact, and aim to ship tools that solve real problems and improve
            over time.
          </p>
          <p>
            This website showcases my projects, designs, and contributions
            across various domains. Feel free to explore my work, and connect
            with me on GitHub, Thingiverse, or Gravatar.
          </p>
        </div>
        <dl class="bio-facts">
          <div><dt>School</dt><dd>GMHS STEM Academy</dd></div>
          <div><dt>Location</dt><dd>Maryland, USA</dd></div>
        </dl>
        <ul class="action-row home-profiles" aria-label="External profiles">
          {
            profiles.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="site-btn site-btn--sm"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label} <UiIcon name="external" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="home-activity" aria-labelledby="activity-title">
        <h2 id="activity-title" class="section-heading">Latest activity</h2>
        {
          recent.map(({ label, icon, title, summary, href, external }) => {
            const Tile = href ? 'a' : 'div';

            return (
              <Tile
                class="glass-panel activity-tile"
                href={href}
                {...(external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <span class="tile-icon">
                  <UiIcon name={icon} />
                </span>
                <div>
                  <p class="section-label">{label}</p>
                  <h3>{title}</h3>
                  {summary && <p class="activity-summary">{summary}</p>}
                </div>
                {href && (
                  <span class="tile-arrow">
                    <UiIcon name={external ? 'external' : 'arrow'} />
                  </span>
                )}
              </Tile>
            );
          })
        }
        <div class="activity-counts">
          <a class="text-link" href="/projects"
            >{projects.length}
            {projects.length === 1 ? 'project' : 'projects'}
            <UiIcon name="arrow" /></a
          >
          <a class="text-link" href="/blog"
            >{posts.length}
            {posts.length === 1 ? 'post' : 'posts'}
            <UiIcon name="arrow" /></a
          >
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const labels = {
    UP: 'Live',
    HASISSUES: 'Issues',
    UNDERMAINTENANCE: 'Maintenance',
    DOWN: 'Outage',
    UNKNOWN: 'Unknown',
  } as const;

  const statusLink = document.querySelector<HTMLElement>('[data-status]');
  const statusLabel = statusLink?.querySelector('[data-status-label]');

  function updateStatus(value: unknown) {
    if (!statusLink || !statusLabel) return;
    const status = typeof value === 'string' ? value.toUpperCase() : '';
    const key = Object.hasOwn(labels, status)
      ? (status as keyof typeof labels)
      : 'UNKNOWN';

    statusLink.dataset.status = key;
    statusLabel.textContent = labels[key];
    statusLink.setAttribute('aria-label', 'Site status: ' + labels[key]);
  }

  if (statusLink) {
    fetch('https://paulsavvas.instatus.com/summary.json', { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error('Status request failed');
        return response.json();
      })
      .then((data) => updateStatus(data?.page?.status))
      .catch(() => updateStatus(undefined));
  }
</script>
