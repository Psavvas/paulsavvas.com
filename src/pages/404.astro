---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';
---

<BaseLayout title="Page not found | Paul Savvas">
  <main class="site-frame page-shell message-page">
    <p class="error-code" aria-hidden="true">404</p>
    <h1 class="display-heading">Page not found.</h1>
    <p class="message-copy">
      Looks like this route is still in prototype mode. Explore my projects or
      blog while this one is on the workbench.
    </p>
    <div class="action-row">
      <a class="site-btn site-btn--primary" href="/"
        >Return home <UiIcon name="arrow" /></a
      >
      <a class="site-btn" href="/projects">View projects</a>
      <a class="site-btn" href="/blog">Visit blog</a>
    </div>
  </main>
</BaseLayout>
