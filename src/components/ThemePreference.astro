<script is:inline>
  (() => {
    const root = document.documentElement;
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    const modes = ['light', 'dark', 'system'];
    let mode = 'system';

    try {
      const stored = localStorage.getItem('ps-theme');
      if (modes.includes(stored)) mode = stored;
    } catch {
      // Keep theme switching available when storage is disabled.
    }

    function applyTheme() {
      root.dataset.theme = mode;
      root.classList.toggle(
        'dark',
        mode === 'dark' || (mode === 'system' && system.matches)
      );
    }

    applyTheme();
    root.dataset.js = '';
    system.addEventListener('change', applyTheme);

    document.addEventListener('DOMContentLoaded', () => {
      const button = document.querySelector('[data-theme-toggle]');
      if (!button) return;

      function nextMode() {
        return modes[(modes.indexOf(mode) + 1) % modes.length];
      }

      function updateLabel() {
        const label = 'Theme: ' + mode + '. Switch to ' + nextMode() + '.';
        button.setAttribute('aria-label', label);
        button.title = label;
      }

      button.addEventListener('click', () => {
        mode = nextMode();
        try {
          localStorage.setItem('ps-theme', mode);
        } catch {
          // The chosen mode still applies for this page.
        }
        applyTheme();
        updateLabel();
      });

      updateLabel();
    });
  })();
</script>
