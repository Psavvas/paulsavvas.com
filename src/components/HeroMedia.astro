---
import UiIcon from './UiIcon.astro';
---

<div class="hero-film">
  <picture class="home-wallpaper">
    <source media="(max-width: 44rem)" srcset="/lakefront-mobile.webp" />
    <img
      src="/lakefront-1280.webp"
      srcset="/lakefront-1280.webp 1280w, /lakefront.webp 2400w"
      sizes="(max-width: 81rem) 91vw, 74rem"
      alt="Chicago skyline and Lake Michigan"
      width="2400"
      height="1080"
      fetchpriority="high"
    />
  </picture>
  <video
    class="home-video"
    data-hero-video
    data-desktop-src="/lakefront.mp4"
    data-mobile-src="/lakefront-mobile.mp4"
    muted
    playsinline
    preload="none"
    aria-hidden="true"></video>
  <button
    class="site-btn hero-video-toggle"
    type="button"
    data-hero-video-toggle
    aria-label="Play skyline video"
    hidden
  >
    <span data-play-icon><UiIcon name="play" /></span>
    <span data-pause-icon><UiIcon name="pause" /></span>
    <span data-video-action>Play video</span>
  </button>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>(
    '[data-hero-video-toggle]'
  );
  const label = toggle?.querySelector('[data-video-action]');

  if (video && toggle && label) {
    const updateControl = () => {
      const playing = !video.paused && !video.ended;
      const action = playing ? 'Pause' : video.ended ? 'Replay' : 'Play';
      toggle.toggleAttribute('data-playing', playing);
      toggle.setAttribute('aria-label', action + ' skyline video');
      label.textContent = action + ' video';
    };

    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      if (!video.paused && !video.ended) {
        video.pause();
        return;
      }

      if (!video.hasAttribute('src')) {
        const compact = window.matchMedia('(max-width: 44rem)').matches;
        const source = compact
          ? video.dataset.mobileSrc
          : video.dataset.desktopSrc;
        if (!source) return;
        video.src = source;
      }

      video.play().catch(updateControl);
    });

    video.addEventListener('play', updateControl);
    video.addEventListener('pause', updateControl);
    video.addEventListener('ended', updateControl);
    video.addEventListener('playing', () =>
      video.setAttribute('data-video-ready', '')
    );
    video.addEventListener('error', () => {
      video.removeAttribute('data-video-ready');
      toggle.hidden = true;
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
    });
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) video.pause();
    });
    observer.observe(video);
  }
</script>
