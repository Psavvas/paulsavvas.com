---
import '../styles/globals.css';
import '../styles/admin.css';
import SiteFonts from '../components/SiteFonts.astro';
import ThemePreference from '../components/ThemePreference.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import UiIcon from '../components/UiIcon.astro';

interface Props {
  title: string;
  bare?: boolean;
}

const { title, bare = false } = Astro.props;

const navEntries = [
  { label: 'Dashboard', path: '/admin' },
  { label: 'Projects', path: '/admin/projects' },
  { label: 'Blog', path: '/admin/blog' },
  { label: 'Banners', path: '/admin/banners' },
  { label: 'Redirects', path: '/admin/redirects' },
  { label: 'About page', path: '/admin/about' },
  { label: 'Account', path: '/admin/account' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Site Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SiteFonts />
    <ThemePreference />
  </head>

  <body class="admin-site">
    <div class:list={['site-frame', { 'admin-layout': !bare }]}>
      {
        !bare && (
          <header class="glass-panel admin-sidebar">
            <div class="admin-toolbar">
              <a class="wordmark" href="/admin">
                <span class="brand-mark" aria-hidden="true">
                  PS
                </span>
                <span>PS Admin</span>
              </a>
              <ThemeToggle />
            </div>

            <nav class="admin-nav" aria-label="Admin navigation">
              <ul>
                {navEntries.map(({ label, path }) => {
                  const current = currentPath === path;
                  const active =
                    current ||
                    (path !== '/admin' && currentPath.startsWith(`${path}/`));
                  return (
                    <li>
                      <a
                        href={path}
                        aria-current={
                          current ? 'page' : active ? 'location' : undefined
                        }
                      >
                        {label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>

            <div class="admin-actions">
              <a
                class="admin-view"
                href="/"
                target="_blank"
                rel="noopener noreferrer"
              >
                View site <UiIcon name="external" />
              </a>
              <form method="post" action="/admin/logout">
                <button type="submit" class="site-btn site-btn--sm">
                  Log out
                </button>
              </form>
            </div>
          </header>
        )
      }

      <main class:list={['admin-main', { 'admin-login': bare }]}>
        <slot />
      </main>
    </div>
  </body>
</html>
