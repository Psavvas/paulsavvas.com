---
import '../styles/globals.css';
import '../styles/site.css';
import Analytics from '@vercel/analytics/astro';
import SiteBanners from '../components/SiteBanners.astro';
import ThemePreference from '../components/ThemePreference.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import UiIcon from '../components/UiIcon.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Paul Savvas — student engineer building practical tools across software, hardware, and 3D design.',
} = Astro.props;

const fullTitle = title.includes('Paul Savvas')
  ? title
  : `${title} | Paul Savvas`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === '/';
const navEntries = [
  { label: 'Home', path: '/', icon: 'home' },
  { label: 'About', path: '/about', icon: 'person' },
  { label: 'Projects', path: '/projects', icon: 'projects' },
  { label: 'Blog', path: '/blog', icon: 'blog' },
  { label: 'Contact', path: '/contact', icon: 'mail' },
] as const;

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://paulsavvas.com" />
    <meta property="og:site_name" content="Paul Savvas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemePreference />
    <Analytics />
  </head>

  <body class:list={['public-site', { 'home-site': isHome }]}>
    <a class="skip-link" href="#site-content">Skip to content</a>
    <SiteBanners />

    <div class="site-stage">
      <header class="site-toolbar">
        <div class="site-frame toolbar-inner">
          <a href="/" class="wordmark">
            <span class="brand-mark" aria-hidden="true">PS</span>
            <span>Paul Savvas</span>
          </a>
          <div class="toolbar-controls">
            <slot name="toolbar" />
            <ThemeToggle />
          </div>
        </div>
      </header>

      <nav class="site-dock" aria-label="Main navigation">
        <ul>
          {
            navEntries.map(({ label, path, icon }) => {
              const current = currentPath === path;
              const active =
                current || (path !== '/' && currentPath.startsWith(`${path}/`));

              return (
                <li>
                  <a
                    href={path}
                    aria-current={
                      current ? 'page' : active ? 'location' : undefined
                    }
                  >
                    <UiIcon name={icon} />
                    <span>{label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="site-content" id="site-content" tabindex="-1">
        <slot />
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-frame footer-inner">
        <span>&copy; {currentYear} Paul Savvas. All rights reserved.</span>
        <a
          class="text-link"
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
        >
          Built with Astro <UiIcon name="external" />
        </a>
      </div>
    </footer>
  </body>
</html>
