---
import '../styles/globals.css';
import '../styles/site.css';
import Analytics from '@vercel/analytics/astro';
import SiteBanners from '../components/SiteBanners.astro';
import SiteFonts from '../components/SiteFonts.astro';
import ThemePreference from '../components/ThemePreference.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import UiIcon from '../components/UiIcon.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Paul Savvas — student engineer building practical tools across software, hardware, and 3D design.',
} = Astro.props;

const fullTitle = title.includes('Paul Savvas')
  ? title
  : `${title} | Paul Savvas`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navEntries = [
  { label: 'Home', path: '/' },
  { label: 'About', path: '/about' },
  { label: 'Projects', path: '/projects' },
  { label: 'Blog', path: '/blog' },
  { label: 'Contact', path: '/contact' },
];

const currentYear = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://paulsavvas.com" />
    <meta property="og:site_name" content="Paul Savvas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SiteFonts />
    <ThemePreference />
    <Analytics />
  </head>

  <body class="public-site">
    <a class="skip-link" href="#site-content">Skip to content</a>
    <SiteBanners />

    <header class="site-header" data-site-header>
      <div class="site-frame header-inner">
        <a href="/" class="wordmark">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Paul Savvas</span>
        </a>

        <div class="header-controls">
          <ThemeToggle />
          <button
            class="icon-control menu-toggle"
            type="button"
            aria-label="Open navigation menu"
            aria-controls="site-navigation"
            aria-expanded="false"
            data-menu-toggle
          >
            <span class="menu-open-icon"><UiIcon name="menu" /></span>
            <span class="menu-close-icon"><UiIcon name="close" /></span>
          </button>
        </div>

        <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
          <ul>
            {
              navEntries.map(({ label, path }) => {
                const current = currentPath === path;
                const active =
                  current ||
                  (path !== '/' && currentPath.startsWith(`${path}/`));

                return (
                  <li>
                    <a
                      href={path}
                      aria-current={
                        current ? 'page' : active ? 'location' : undefined
                      }
                    >
                      {label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="site-content" id="site-content" tabindex="-1">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="site-frame footer-inner">
        <span>&copy; {currentYear} Paul Savvas. All rights reserved.</span>
        <a
          class="text-link"
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
        >
          Built with Astro <UiIcon name="external" />
        </a>
      </div>
    </footer>
  </body>
</html>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuToggle =
    header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && menuToggle) {
    const setMenu = (open: boolean) => {
      header.toggleAttribute('data-menu-open', open);
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu'
      );
    };

    menuToggle.addEventListener('click', () =>
      setMenu(!header.hasAttribute('data-menu-open'))
    );
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) {
        setMenu(false);
        menuToggle.focus();
      }
    });
  }
</script>
